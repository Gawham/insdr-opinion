runtime: nodejs22
service: gotham

instance_class: F2

env_variables:
  PORT: "8080"

  # Blockchain Configuration
  PRIVATE_KEY: "your-private-key-here"
  DEVELOPER_PRIVATE_KEY: "your-developer-private-key-here"
  ETHERLINK_RPC: "https://node.shadownet.etherlink.com"

  # Contract Addresses
  CONTRACT_ADDRESS: "your-contract-address-here"
  GOTHAM_FACTORY_ADDRESS: "your-factory-address-here"

  # Test Wallet Addresses
  CLIENT_WALLET_ADDRESS: "your-client-wallet-address-here"
  DEVELOPER_WALLET_ADDRESS: "your-developer-wallet-address-here"

  # Google Cloud Storage
  GCP_PROJECT_ID: "your-gcp-project-id"
  BUCKET_NAME: "your-bucket-name"

  # AI/LLM Configuration
  GEMINI_API_KEY: "your-gemini-api-key-here"
  LLM_MODEL: "gemini-3-flash-preview"

handlers:
  - url: /.*
    script: auto
    secure: always

automatic_scaling:
  target_cpu_utilization: 0.65
  min_instances: 1
  max_instances: 10
  min_pending_latency: 30ms
  max_pending_latency: automatic
  max_concurrent_requests: 50
